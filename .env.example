# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini — either env name is accepted by the LLM factory
GEMINI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
